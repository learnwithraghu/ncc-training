      "x": 80, "y": 1210, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff",
      "width": 1320, "height": 90, "seed": 201, "groupIds": [], "frameId": null,
      "roundness": {"type": 3}, "boundElements": [{"id": "footer_t", "type": "text"}],
      "updated": 1, "link": null, "locked": false
    },
    {
      "type": "text", "version": 1, "versionNonce": 202, "isDeleted": false, "id": "footer_t",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0,
      "x": 80, "y": 1210, "strokeColor": "#1971c2", "backgroundColor": "transparent",
      "width": 1320, "height": 90, "seed": 202, "groupIds": [], "frameId": null, "roundness": null,
      "boundElements": [], "updated": 1, "link": null, "locked": false,
      "text": "A container is just an ordinary Linux process — wrapped in namespaces (isolation), throttled by cgroups (limits), given a filesystem by OverlayFS (layers), and locked down by seccomp/capabilities. No hypervisor, no guest OS — every container shares the host kernel.",
      "fontSize": 18, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle",
      "containerId": "footer_box",
      "originalText": "A container is just an ordinary Linux process — wrapped in namespaces (isolation), throttled by cgroups (limits), given a filesystem by OverlayFS (layers), and locked down by seccomp/capabilities. No hypervisor, no guest OS — every container shares the host kernel.",
      "lineHeight": 1.3
    }
