pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        CODE_DIR  = '/var/jenkins_code'
        IMAGE_TAG = "python-app:${BUILD_NUMBER}"
    }

    stages {
        stage('Syntax Check') {
            steps {
                sh '''
                    cd "${CODE_DIR}"
                    for f in app.py test_app.py; do
                        python3 -m py_compile "${f}"
                    done
                '''
            }
        }
        stage('Unit Tests') {
            steps {
                sh '''
                    cd "${CODE_DIR}"
                    mkdir -p "${WORKSPACE}/reports"
                    python3 -m pytest test_app.py -v \
                        --junitxml="${WORKSPACE}/reports/results.xml"
                '''
            }
            post {
                always {
                    junit 'reports/results.xml'
                }
            }
        }
        stage('Docker Build') {
            steps {
                sh '''
                    cd "${CODE_DIR}"
                    docker build -t "${IMAGE_TAG}" .
                    docker images "${IMAGE_TAG}"
                '''
            }
        }
        stage('Docker Smoke Test') {
            steps {
                sh '''
                    docker run --rm "${IMAGE_TAG}" fizzbuzz 15
                '''
            }
        }
    }
}
