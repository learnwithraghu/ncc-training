{
    "name": "kodekloud/simple-project",
    "description": "Sample PHP app used to teach Jenkins CI stage by stage.",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9",
        "phpmd/phpmd": "^2.15",
        "sebastian/phpcpd": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
