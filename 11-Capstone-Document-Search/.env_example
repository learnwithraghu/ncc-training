# AWS CLI credentials (local use — copy into a step folder as .env and fill real values)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# LLM configuration
LLM_API_KEY=your_llm_api_key
LLM_API_ENDPOINT=https://your-llm-api-endpoint.example.com/v1
LLM_MODEL=your_llm_model_name

# ECR configuration
ECR_REPOSITORY_NAME=document-search
ECR_REGISTRY_ID=your_aws_account_id
