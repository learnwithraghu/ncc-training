# AWS CLI credentials (local use for ECR push — copy into a step folder as .env)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# LLM configuration (used by the Streamlit app at runtime)
LLM_API_KEY=your_llm_api_key
LLM_API_ENDPOINT=https://your-llm-api-endpoint.example.com/v1/chat/completions
LLM_MODEL=your_llm_model_name

# ECR configuration
ECR_REPOSITORY_NAME=document-search
ECR_REGISTRY_ID=your_aws_account_id
