pipeline {
    agent any

    parameters {
        choice(name: 'COMMAND', choices: ['add', 'is_prime'], description: 'Which app.py command to run')
    }

    stages {
        stage('Syntax Check') {
            steps {
                sh 'python3 -m py_compile app.py'
            }
        }
        stage('Lint') {
            steps {
                sh 'flake8 app.py'
            }
        }
        stage('Run') {
            steps {
                // NOTE: this line is intentionally vulnerable - see the guide.
                sh "python3 app.py ${params.COMMAND} 2 3"
            }
        }
    }
}
